# Public Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Server-only Gemini configuration
GEMINI_API_KEY=
# Opsional. Jangan pakai gemini-1.5-* / gemini-2.0-* (sudah dimatikan Google). Default: gemini-2.5-flash-lite (hemat token)
GEMINI_MODEL=gemini-2.5-flash-lite

# Canonical public origin for metadata and share links
NEXT_PUBLIC_SITE_URL=https://bloomora-lovat-theta.vercel.app
