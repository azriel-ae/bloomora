# Supabase public URL and anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secrets: never prefix with NEXT_PUBLIC_ and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only PostgreSQL connection URI; use the Supabase pooler appropriate for runtime.
SUPABASE_DB_URL=

# Server-only Gemini configuration
GEMINI_API_KEY=
# Optional. Avoid retired Gemini 1.5/2.0 models. Default: gemini-2.5-flash-lite.
GEMINI_MODEL=gemini-2.5-flash-lite

# Canonical public origin for metadata and share links
NEXT_PUBLIC_SITE_URL=https://bloomora.my.id
