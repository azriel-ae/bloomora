{
  "name": "bloomora",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:supabase": "node --conditions=react-server --experimental-strip-types --test tests/supabase/*.test.ts",
    "test:browser": "node tests/browser/build.mjs && node tests/browser/run.mjs",
    "test:catalog": "node tests/browser/catalog.mjs",
    "test:editor": "node tests/browser/editor.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^12.18.1",
    "html-to-image": "^1.11.13",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "postgres": "^4.0.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@zxing/library": "^0.23.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
